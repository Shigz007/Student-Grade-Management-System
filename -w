                    <div class="form-group"><label class="form-control-label">新密码 <span class="text-danger pw-req">*</span> <small class="text-danger field-error" id="err-new-pw"></small></label><input type="password" class="form-control form-control-sm" id="profile-new-pw" placeholder="至少6位"></div>
                    <div class="form-group"><label class="form-control-label">确认新密码 <span class="text-danger pw-req">*</span> <small class="text-danger field-error" id="err-confirm-pw"></small></label><input type="password" class="form-control form-control-sm" id="profile-confirm-pw" placeholder="再次输入新密码"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-dismiss="modal">取消</button>
