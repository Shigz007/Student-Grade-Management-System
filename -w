    <style>
        :root {
            --sidebar-width: 250px;
            --topbar-height: 64px;
        }
        .sidebar {
            position: fixed; top: 0; left: 0; bottom: 0; width: var(--sidebar-width);
            background: #1e1e2d; z-index: 1050; overflow-y: auto;
            transition: transform 0.3s ease;
            display: flex; flex-direction: column;
            border-right: 1px solid #16161f;
        }
        .sidebar-bottom { display: none; padding: 16px 24px; border-top: 1px solid rgba(255,255,255,0.08); }
        .sidebar-bottom .sidebar-user-link { color: #a2a3b7; text-decoration: none; font-size: 0.85rem; cursor: pointer; }
        .sidebar-bottom .sidebar-user-link:hover { color: #fff; text-decoration: none; }
        .sidebar-badge-group, .sidebar-logout-group { display: none; }
        .modal-header .close { font-size: 1.8rem; font-weight: 300; color: #525f7f; opacity: 0.7; text-shadow: none; padding: 0; margin: 0; line-height: 1; height: 1.8rem; display: flex; align-items: center; justify-content: center; }
        .modal-header .close:hover { opacity: 1; color: #000; }
        .sidebar .sidebar-brand { padding: 20px 24px; }
        .sidebar .sidebar-brand a { color: #fff; font-size: 1.15rem; text-decoration: none; font-weight: 600; }
        .sidebar .nav-section { padding: 16px 24px 8px; color: #6c6d85; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1.5px; font-weight: 600; }
        .sidebar .navigation { list-style: none; padding: 0; margin: 0; }
        .sidebar .navigation-link {
            display: block; padding: 12px 24px; margin-bottom: 4px; color: #a2a3b7; text-decoration: none;
            transition: all 0.15s; font-size: 0.9rem;
