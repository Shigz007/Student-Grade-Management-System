        .page-jump-input { width: 42px; text-align: center; padding: 4px 2px; height: 34px; -moz-appearance: textfield; }
        .page-jump-input::-webkit-inner-spin-button, .page-jump-input::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }

        @media (max-width: 1199px) {
            .menu-toggle { display: inline-block; }
            .main-content { margin-left: 0; }
            .topbar { left: 0; }
            .sidebar { transform: translateX(-100%); }
            .sidebar.toggled { transform: translateX(0); }
