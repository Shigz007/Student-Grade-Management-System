        .btn:focus, .btn.focus, a:focus, button:focus { outline: 0 !important; box-shadow: 0 0 0 2px rgba(108,117,125,0.35) !important; }
        .btn:active, .btn.active { box-shadow: inset 0 2px 3px rgba(0,0,0,0.12) !important; }
        .table td, .table th { padding: 0.6rem 0.75rem; white-space: nowrap; vertical-align: middle; line-height: 1.3; }
        .recent-table td, .recent-table th { white-space: normal; font-size: 0.875rem; }
        .table td:first-child, .table th:first-child { padding-left: 1.5rem; }
        .table td:last-child, .table th:last-child {
            padding-right: 1.5rem;
            position: sticky; right: 0; background: #fff; z-index: 1;
        }
        .table thead th:last-child { z-index: 3; }
        .table tbody td:last-child { box-shadow: -10px 0 14px -8px rgba(0,0,0,0.2); }
        .table th { border-top: none; font-size: 0.78rem; text-transform: uppercase; color: #8898aa; font-weight: 600; letter-spacing: 0.5px; }

        .menu-toggle { display: none; background: none; border: none; font-size: 1.4rem; cursor: pointer; color: #525f7f; padding: 0 8px; }
        .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1040; }
        body.sidebar-open .sidebar-overlay { display: block; }

        .table-responsive {
            -webkit-overflow-scrolling: touch;
            scroll-behavior: smooth;
            background:
                linear-gradient(to right, #fff 30%, rgba(255,255,255,0)),
                linear-gradient(to left, #fff 30%, rgba(255,255,255,0)) 100% 0,
                radial-gradient(farthest-side at 0% 50%, rgba(0,0,0,.12), rgba(0,0,0,0)),
                radial-gradient(farthest-side at 100% 50%, rgba(0,0,0,.12), rgba(0,0,0,0)) 100% 0;
            background-repeat: no-repeat;
            background-size: 30px 100%, 30px 100%, 10px 100%, 10px 100%;
