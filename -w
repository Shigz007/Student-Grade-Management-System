        .sidebar .navigation-link i { width: 22px; margin-right: 10px; text-align: center; }

        .main-content { margin-left: var(--sidebar-width); min-height: 100vh; background: #f5f5f9; overflow-x: hidden; padding-top: var(--topbar-height); }
        .topbar { position: fixed; top: 0; left: var(--sidebar-width); right: 0; height: var(--topbar-height); padding: 0 24px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e8e8ef; background: #fff; z-index: 1030; }
